# ============================================================
# Pixel-ZeroBaran | متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم.
# كل الخدمات هنا لها خطط مجانية كاملة.
# ============================================================

# ---------- Hugging Face (مجاني بالكامل) ----------
# احصل عليه من: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL_BG=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_INPAINT=runwayml/stable-diffusion-inpainting

# ---------- Google Gemini (طبقة مجانية سخية) ----------
# احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Supabase (مجاني بالكامل حتى 500MB) ----------
# احصل عليه من: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_BUCKET_RAW=pixel-raw
SUPABASE_BUCKET_GENERATED=pixel-generated

# ---------- Telegram Bot (مجاني بالكامل) ----------
# تحدث مع @BotFather على تليجرام لإنشاء بوت والحصول على التوكن
TELEGRAM_BOT_TOKEN=1234567890:AAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# الـ chat_id الخاص بك (تحدث مع @userinfobot لمعرفته)
TELEGRAM_CHAT_ID=
